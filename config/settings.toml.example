# duet 설정 예시 — 실제 스키마 (src-tauri/src/services/settings.rs)
#
# 저장 위치 (앱이 직접 읽고 쓴다):
#   macOS   ~/Library/Application Support/duet/settings.toml
#   Linux   ~/.config/duet/settings.toml
#   Windows %APPDATA%\duet\settings.toml
#
# 보통은 설정 창(Ctrl+,)에서 바꾸면 이 파일에 저장된다. 직접 편집할 거면 앱을 끄고 하기.
# 여기 없는 키는 무시된다 — 아래가 현재 존재하는 키 전부다.
#
# 섹션([general] 등)은 없다. 평면 구조이고, 맵 두 개는 반드시 파일 맨 끝에 온다
# (TOML 은 테이블 뒤에 scalar 를 둘 수 없다).

# ── 안전 ─────────────────────────────────────────────────────────────
# 영구 삭제(Shift+Delete) 활성화. 디폴트 false — CLAUDE.md §3.
# true 로 켜도 삭제 시 단어("delete") 타이핑 확인은 그대로.
permanent_delete_enabled = false

# 휴지통으로 보내기 전 확인 다이얼로그. 디폴트 true.
# 휴지통 항목은 Ctrl+Z 로 돌아오므로 꺼도 안전하다. 영구 삭제는 이 설정과 무관하게 항상 확인.
confirm_trash_delete = true

# ── 파일 작업 ────────────────────────────────────────────────────────
# 같은 이름이 이미 있을 때 다이얼로그에서 미리 골라 둘 항목.
# "skip"(아무것도 안 덮어씀) | "keepboth"(새 이름) | "replace"(덮어쓰기)
transfer_conflict_default = "skip"

# 이번 세션 동안 마지막에 고른 충돌 정책을 다음 다이얼로그의 기본으로.
remember_conflict_choice = false

# 복사/이동 확인 다이얼로그를 언제 띄울지.
# "conflicts_only"(덮어쓸 게 있을 때만) | "always" | "never"
# 덮어쓸 것이 있으면 이 설정과 무관하게 항상 묻는다.
confirm_transfer = "conflicts_only"

# ── 외관 ─────────────────────────────────────────────────────────────
# "system" | "light" | "dark"
theme = "system"

# ── 새 탭 기본값 ─────────────────────────────────────────────────────
# "name" | "size" | "mtime" | "kind" | "ext"
default_sort = "name"

# "details" | "grid" | "tiles"
default_view = "details"

# 새 탭에서 숨김 파일(dotfile) 표시
show_hidden_default = false

# ── 목록 동작 ────────────────────────────────────────────────────────
# 한 번 클릭으로 열기 (디폴트 false = 더블클릭)
single_click_open = false

# 그리드/타일 뷰 이미지 썸네일 (PNG/JPG/GIF/WebP/BMP, 디스크 캐시)
show_thumbnails = true

# 파일 목록에 OS 네이티브 아이콘 — Windows 로컬 파일 전용. 디폴트: Windows 만 true.
os_file_icons = false

# ── 폴더 비교 창 ─────────────────────────────────────────────────────
# 비교에서 무시할 glob 패턴 (마지막 사용 값이 저장된다)
compare_ignore_globs = []

# 수정시각 허용 오차(ms) — FAT/네트워크 드라이브의 1~2초 차이를 같다고 볼 때
compare_mtime_tolerance_ms = 0

# ── 맵 (반드시 파일 맨 끝) ───────────────────────────────────────────
# 확장자(소문자, 점 없음) → 아이콘 팔레트 이름. 내장 매핑보다 우선.
[ext_icon_overrides]
# rs = "code"
# psd = "image"

# 확장자 → 이 프로그램으로 열기. 지정하면 OS 기본 연결 대신 사용.
[ext_app_overrides]
# md = "/Applications/Typora.app"
# log = "C:\\Program Files\\Notepad++\\notepad++.exe"
